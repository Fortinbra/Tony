# Environment variables for Tony Bot Docker deployment
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGODB_CONNECTION_STRING=mongodb://admin:your_mongo_password@mongodb:27017/TonyBot?authSource=admin
MONGODB_DATABASE_NAME=TonyBot

# MongoDB Root Credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Optional: Custom MongoDB connection for external database
# MONGODB_CONNECTION_STRING=mongodb://your_external_mongodb_host:27017/TonyBot

# Optional: Timezone configuration
TZ=UTC
